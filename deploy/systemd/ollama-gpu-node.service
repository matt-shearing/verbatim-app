# Installed on the GPU node as ~/.config/systemd/user/ollama.service
# (user-level: no sudo there). Enable lingering so it survives logout/reboot:
#   systemctl --user daemon-reload && systemctl --user enable --now ollama
#   loginctl enable-linger "$USER"
[Unit]
Description=Ollama local LLM server (user)
After=network-online.target

[Service]
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_CONTEXT_LENGTH=24576
Environment=OLLAMA_KEEP_ALIVE=30m
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
